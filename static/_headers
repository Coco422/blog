/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net https://giscus.app; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net https://giscus.app; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://giscus.app https://api.github.com; frame-src https://giscus.app
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/giscus-paper.css
  Access-Control-Allow-Origin: https://giscus.app

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/index.json
  X-Robots-Tag: noindex

# Dooki replaces only "noindex, follow" on the public CDN response.
# Preserve the separate /index.json noindex directive above.
https://blog-dc5.pages.dev/*
  X-Robots-Tag: noindex, follow

https://:deployment.blog-dc5.pages.dev/*
  X-Robots-Tag: noindex, follow

# Search ownership verification files stay crawlable but out of search results.
/BingSiteAuth.xml
  X-Robots-Tag: noindex

/776d95cff915e5d44420eaf8566481b6.txt
  X-Robots-Tag: noindex

#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_FILE=/etc/wireguard/wg-man.conf
SERVER_CONF=/etc/wireguard/wg0.conf
CLIENT_DIR=/etc/wireguard/clients
META_DIR=/etc/wireguard/peers.d
LOCK_FILE=/run/lock/wg-man.lock

INTERFACE=wg0
ENDPOINT=wg.example.com:51820
VPN_PREFIX=10.66.0
VPN_CIDR=10.66.0.0/24
HOME_LAN=192.168.50.0/24
CLIENT_PREFIX=24
MTU=1380
ONLINE_SECONDS=180
TEMP_DIR=''

die() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
    rm -rf -- "$TEMP_DIR"
  fi
}
trap cleanup EXIT

load_config() {
  [[ -e "$CONFIG_FILE" ]] || return 0
  [[ $(stat -c '%u' "$CONFIG_FILE") -eq 0 ]] || \
    die "$CONFIG_FILE 必须归 root 所有。"

  local mode key value
  mode=$(stat -c '%a' "$CONFIG_FILE")
  (( (8#$mode & 022) == 0 )) || \
    die "$CONFIG_FILE 不能允许 group/other 写入。"

  while IFS='=' read -r key value; do
    [[ -n "$key" && "$key" != \#* ]] || continue
    value=${value%$'\r'}
    case "$key" in
      INTERFACE|ENDPOINT|VPN_PREFIX|VPN_CIDR|HOME_LAN|CLIENT_PREFIX|MTU|ONLINE_SECONDS)
        printf -v "$key" '%s' "$value"
        ;;
      *) die "$CONFIG_FILE 包含未知配置项：$key" ;;
    esac
  done < "$CONFIG_FILE"
}

validate_settings() {
  [[ "$INTERFACE" =~ ^[A-Za-z0-9_=+.-]{1,15}$ ]] || die 'INTERFACE 不合法。'
  [[ "$VPN_PREFIX" =~ ^([0-9]{1,3}\.){2}[0-9]{1,3}$ ]] || die 'VPN_PREFIX 不合法。'
  [[ "$VPN_CIDR" == "$VPN_PREFIX.0/24" ]] || \
    die '当前版本只支持与 VPN_PREFIX 对应的 IPv4 /24 网段。'
  [[ "$CLIENT_PREFIX" == 24 ]] || die '当前版本只支持 CLIENT_PREFIX=24。'
  [[ "$ENDPOINT" =~ ^[^[:space:]:]+:[0-9]{1,5}$ ]] || \
    die 'ENDPOINT 必须为域名或 IPv4:port。'
  local port=${ENDPOINT##*:}
  (( port >= 1 && port <= 65535 )) || die 'ENDPOINT 端口不合法。'
  [[ "$MTU" =~ ^[0-9]+$ && "$ONLINE_SECONDS" =~ ^[0-9]+$ ]] || \
    die 'MTU 和 ONLINE_SECONDS 必须是整数。'
}

need_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die '请使用 root 或 sudo 运行。'
}

need_commands() {
  local command
  for command in wg wg-quick qrencode flock numfmt systemctl ss getent awk grep \
    seq install mktemp stat date sysctl tail wc tr cp chmod rm; do
    command -v "$command" >/dev/null 2>&1 || die "缺少命令：$command"
  done
}

ensure_layout() {
  [[ -f "$SERVER_CONF" ]] || die "找不到服务端配置：$SERVER_CONF"
  install -d -o root -g root -m 700 "$CLIENT_DIR" "$META_DIR"
}

peer_name_for_key() {
  local wanted=$1 meta name ip pub created
  for meta in "$META_DIR"/*.tsv; do
    [[ -e "$meta" ]] || continue
    IFS=$'\t' read -r name ip pub created < "$meta"
    if [[ "$pub" == "$wanted" ]]; then
      printf '%s' "$name"
      return 0
    fi
  done
  printf '%s' 'unknown'
}

human_bytes() {
  numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || printf '%sB' "$1"
}

cmd_add() {
  need_root
  need_commands
  [[ $# -eq 1 ]] || die '用法：wg-man add <名称>'
  local name=$1
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || \
    die '名称只能包含字母、数字、点、下划线和连字符，且最长 64 个字符。'

  ensure_layout
  exec 9>"$LOCK_FILE"
  flock -x 9

  [[ ! -e "$META_DIR/$name.tsv" && ! -e "$CLIENT_DIR/$name.conf" ]] || \
    die "节点 $name 已存在。"
  systemctl is-active --quiet "wg-quick@$INTERFACE" || \
    die "wg-quick@$INTERFACE 未运行。"

  local host ip=''
  for host in $(seq 2 254); do
    if ! grep -Eq "(^|[ ,])${VPN_PREFIX}\\.${host}/32([, ]|$)" "$SERVER_CONF"; then
      ip="${VPN_PREFIX}.${host}"
      break
    fi
  done
  [[ -n "$ip" ]] || die "网段 $VPN_CIDR 已无可分配地址。"

  local tmp_dir client_private client_public psk server_public created
  tmp_dir=$(mktemp -d /etc/wireguard/.wg-man.XXXXXX)
  TEMP_DIR=$tmp_dir
  client_private=$(wg genkey)
  client_public=$(printf '%s' "$client_private" | wg pubkey)
  psk=$(wg genpsk)
  server_public=$(wg show "$INTERFACE" public-key)
  created=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  cp --preserve=mode,ownership "$SERVER_CONF" "$tmp_dir/wg0.conf"
  {
    printf '\n# wg-man: %s; created %s\n' "$name" "$created"
    printf '%s\n' '[Peer]'
    printf 'PublicKey = %s\n' "$client_public"
    printf 'PresharedKey = %s\n' "$psk"
    printf 'AllowedIPs = %s/32\n' "$ip"
  } >> "$tmp_dir/wg0.conf"

  {
    printf '%s\n' '[Interface]'
    printf 'PrivateKey = %s\n' "$client_private"
    printf 'Address = %s/%s\n' "$ip" "$CLIENT_PREFIX"
    printf 'MTU = %s\n\n' "$MTU"
    printf '%s\n' '[Peer]'
    printf 'PublicKey = %s\n' "$server_public"
    printf 'PresharedKey = %s\n' "$psk"
    printf 'Endpoint = %s\n' "$ENDPOINT"
    printf 'AllowedIPs = %s, %s\n' "$VPN_CIDR" "$HOME_LAN"
    printf '%s\n' 'PersistentKeepalive = 25'
  } > "$tmp_dir/$name.conf"
  chmod 600 "$tmp_dir/$name.conf"
  qrencode -o "$tmp_dir/$name.png" -r "$tmp_dir/$name.conf"
  chmod 600 "$tmp_dir/$name.png"
  printf '%s\t%s\t%s\t%s\n' "$name" "$ip" "$client_public" "$created" \
    > "$tmp_dir/$name.tsv"
  chmod 600 "$tmp_dir/$name.tsv"

  wg-quick strip "$tmp_dir/wg0.conf" >/dev/null
  cp --preserve=mode,ownership "$SERVER_CONF" "$SERVER_CONF.prev"
  install -o root -g root -m 600 "$tmp_dir/wg0.conf" "$SERVER_CONF"
  install -o root -g root -m 600 "$tmp_dir/$name.conf" "$CLIENT_DIR/$name.conf"
  install -o root -g root -m 600 "$tmp_dir/$name.png" "$CLIENT_DIR/$name.png"
  install -o root -g root -m 600 "$tmp_dir/$name.tsv" "$META_DIR/$name.tsv"

  if ! systemctl reload "wg-quick@$INTERFACE"; then
    install -o root -g root -m 600 "$SERVER_CONF.prev" "$SERVER_CONF"
    systemctl reload "wg-quick@$INTERFACE" || true
    rm -f -- "$CLIENT_DIR/$name.conf" "$CLIENT_DIR/$name.png" "$META_DIR/$name.tsv"
    die '重载失败，服务端配置已回滚。'
  fi

  printf '已添加节点：%s\n' "$name"
  printf '隧道地址：%s\n' "$ip"
  printf '配置文件：%s/%s.conf\n' "$CLIENT_DIR" "$name"
  printf '二维码：%s/%s.png\n' "$CLIENT_DIR" "$name"
  if [[ -t 1 ]]; then
    printf '\n可直接用手机 WireGuard 扫描：\n'
    qrencode -t ANSIUTF8 -r "$CLIENT_DIR/$name.conf"
  fi
}

cmd_status() {
  need_root
  need_commands
  ensure_layout
  local wg_state nft_state ssh_state dns_ip peer_count online_count now latest port listen
  wg_state=$(systemctl is-active "wg-quick@$INTERFACE" 2>/dev/null || true)
  nft_state=$(systemctl is-active nftables 2>/dev/null || true)
  ssh_state=$(systemctl is-active ssh 2>/dev/null || true)
  dns_ip=$(getent ahostsv4 "${ENDPOINT%:*}" | awk 'NR==1 {print $1}')
  peer_count=$(wg show "$INTERFACE" peers 2>/dev/null | wc -w | tr -d ' ')
  port=${ENDPOINT##*:}
  listen=$(ss -H -lun | awk -v port="$port" '$4 ~ (":" port "$") {print $4; exit}')
  online_count=0
  now=$(date +%s)
  while IFS=$'\t' read -r _ _ _ _ latest _ _ _; do
    if [[ "$latest" =~ ^[0-9]+$ ]] && (( latest > 0 && now - latest <= ONLINE_SECONDS )); then
      ((online_count += 1))
    fi
  done < <(wg show "$INTERFACE" dump 2>/dev/null | tail -n +2)

  printf 'WireGuard 服务：%s\n' "${wg_state:-unknown}"
  printf 'nftables：%s\n' "${nft_state:-unknown}"
  printf 'SSH：%s\n' "${ssh_state:-unknown}"
  printf 'Endpoint：%s（解析 %s）\n' "$ENDPOINT" "${dns_ip:-失败}"
  printf '监听：%s\n' "${listen:-未监听}"
  printf 'IPv4 转发：%s\n' "$(sysctl -n net.ipv4.ip_forward)"
  printf '节点：%s 个，最近 %s 秒在线 %s 个\n' \
    "$peer_count" "$ONLINE_SECONDS" "$online_count"
}

cmd_ls() {
  need_root
  need_commands
  ensure_layout
  local now count pub endpoint allowed latest rx tx name address state seen age
  now=$(date +%s)
  count=0
  printf '%-18s %-15s %-8s %-20s %-10s %-10s %s\n' \
    'NAME' 'ADDRESS' 'STATE' 'LAST_HANDSHAKE' 'RX' 'TX' 'ENDPOINT'
  while IFS=$'\t' read -r pub _ endpoint allowed latest rx tx _; do
    [[ -n "$pub" ]] || continue
    ((count += 1))
    name=$(peer_name_for_key "$pub")
    address=${allowed%%,*}
    if [[ "$latest" == 0 ]]; then
      state='never'
      seen='-'
    else
      age=$((now - latest))
      if (( age <= ONLINE_SECONDS )); then
        state='online'
      else
        state='stale'
      fi
      seen=$(date -d "@$latest" '+%F %T')
    fi
    [[ "$endpoint" != '(none)' ]] || endpoint='-'
    printf '%-18s %-15s %-8s %-20s %-10s %-10s %s\n' \
      "$name" "$address" "$state" "$seen" "$(human_bytes "$rx")" \
      "$(human_bytes "$tx")" "$endpoint"
  done < <(wg show "$INTERFACE" dump | tail -n +2)
  printf '\n节点总数：%s；online 表示最近 %s 秒内握手。\n' \
    "$count" "$ONLINE_SECONDS"
}

usage() {
  cat <<'EOF'
用法：
  wg-man add <名称>   创建独立节点配置和二维码
  wg-man status       查看服务、DNS、端口和在线节点摘要
  wg-man ls           列出所有节点及握手、流量和连接状态
EOF
}

main() {
  load_config
  validate_settings
  local subcommand=${1:-}
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$subcommand" in
    add) cmd_add "$@" ;;
    status) [[ $# -eq 0 ]] || die 'status 不接受参数。'; cmd_status ;;
    ls) [[ $# -eq 0 ]] || die 'ls 不接受参数。'; cmd_ls ;;
    -h|--help|help|'') usage ;;
    *) die "未知命令：$subcommand" ;;
  esac
}

main "$@"
